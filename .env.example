# ==============================================================================
# Legal Contract Analysis - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="Legal Contract Analysis Engine"
APP_ENV=development
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# AI / LLM Provider Configuration
# Set LLM_PROVIDER to "openai", "azure_openai", or "mock" (for zero-cost local testing without API keys)
LLM_PROVIDER=openai

# OpenAI Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI Settings (Optional if using Azure)
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Database Settings
# By default, uses SQLite for seamless local development. Change to PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/legal_contracts
DATABASE_URL=sqlite:///./storage/legal_contracts.db

# Vector Database (ChromaDB) Path
CHROMA_PERSIST_DIRECTORY=./storage/chroma_db

# File Storage
UPLOAD_DIRECTORY=./storage/uploads
MAX_FILE_SIZE_MB=25
